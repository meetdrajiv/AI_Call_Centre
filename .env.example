# OfficeAI Call Center Configuration

# Application
PROJECT_NAME=OfficeAI Call Center
VERSION=1.0.0
DEBUG=false
ENVIRONMENT=production
LOG_LEVEL=INFO
RATE_LIMIT=100/minute

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/officeai
REDIS_URL=redis://redis:6379/0

# Security
SECRET_KEY=change-this-to-a-random-secret-key
JWT_SECRET_KEY=change-this-to-a-random-jwt-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRES=30
JWT_REFRESH_TOKEN_EXPIRES=7

# Twilio - Voice & SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_SIP_DOMAIN=

# OpenAI - AI & Realtime
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview
OPENAI_WHISPER_MODEL=whisper-1

# ElevenLabs - Text-to-Speech
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# CORS
CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

# Storage
STORAGE_BACKEND=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=officeai-recordings

# Vector Database
VECTOR_DB_BACKEND=chroma
CHROMA_PERSIST_DIR=/data/chroma
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# AI Configuration
NEPALI_SUPPORT_ENABLED=true
DEFAULT_LANGUAGE=en

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_TRACK_STARTED=true
CELERY_TASK_TIME_LIMIT=300

# Monitoring
PROMETHEUS_ENABLED=false
GRAFANA_ADMIN_PASSWORD=admin

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
